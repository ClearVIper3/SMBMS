# SMBMS 环境变量样例
# 使用方式：复制为 .env 并按需修改；.env 已在 .gitignore 中忽略，不会进入版本库。
# Spring Boot 不会自动加载 .env，需要由启动脚本/IDE 将其注入到进程环境变量。

SMBMS_DB_USERNAME=root
SMBMS_DB_PASSWORD=123456
SMBMS_DB_URL=jdbc:mysql://localhost:3306/smbms?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# JWT 签名密钥（生产必须设置；至少 32 字节）
SMBMS_JWT_SECRET=please-change-this-very-long-dev-only-secret-key-32+bytes
SMBMS_JWT_TTL=7200
