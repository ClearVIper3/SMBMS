# SMBMS 环境变量样例
# 使用方式：复制为 .env 并填入真实值；.env 已在 .gitignore 中忽略，不会进入版本库。

# 数据库
SMBMS_DB_USERNAME=<YOUR_DB_USERNAME>
SMBMS_DB_PASSWORD=<YOUR_DB_PASSWORD>
SMBMS_DB_URL=jdbc:mysql://localhost:3306/smbms?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# JWT 签名密钥（至少 32 字节随机字符串）
SMBMS_JWT_SECRET=<YOUR_JWT_SECRET_AT_LEAST_32_BYTES>
SMBMS_JWT_TTL=7200

# Docker Compose 使用
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>

# AI 助手（可选；不填则 AI 功能关闭）
SMBMS_AI_ENABLED=true
SMBMS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMBMS_AI_API_KEY=<YOUR_AI_API_KEY>
SMBMS_AI_MODEL=qwen-plus
SMBMS_AI_TEMPERATURE=0.3
SMBMS_AI_MEMORY_WINDOW=20
SMBMS_AI_TIMEOUT=60
